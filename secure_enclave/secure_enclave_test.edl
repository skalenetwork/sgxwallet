#define SMALL_BUF_SIZE 1024

enclave {

    // Import all calls from common
    from "secure_enclave_common.edl" import *;

    trusted {

        // ------------------------------------------------------------------------------------------
        // Test-only ECALLs
        // ------------------------------------------------------------------------------------------

        // Decrypts encrypted_payload using sek_hex and checks whether the plaintext
        // matches expected_plaintext. Nothing leaves the enclave — only a 0/1 match
        // result is returned. errStatus != 0 means decryption itself failed (e.g. wrong key).
        public void trustedTestDecryptAndMatch(
                                [out] int *errStatus,
                                [out, count = SMALL_BUF_SIZE] char *err_string,
                                [in, string] const char *sek_hex,
                                [in, count = SMALL_BUF_SIZE] uint8_t *encrypted_payload,
                                uint64_t encrypted_payload_len,
                                [in, string] const char *expected_plaintext,
                                [out] int *matches);

        // Decrypts an encrypted DKG secret and returns plaintext to caller.
        // This is test-only and must not be exposed in production builds.
        public void trustedDecryptDkgSecret(
                    [out] int *errStatus,
                    [out, count = SMALL_BUF_SIZE] char *err_string,
                    [in, count = 3050] uint8_t *encrypted_dkg_secret,
                    uint64_t enc_len,
                    [out, count = 3072] uint8_t *decrypted_dkg_secret);

        // DKG V3 is not enabled in production builds yet.
        public void trustedGenDkgSecretV3 (
                                [out] int *errStatus,
                                [out, count = SMALL_BUF_SIZE] char* err_string,
                                [in, count = encrypted_free_term_length] uint8_t* encrypted_free_term,
                                uint64_t encrypted_free_term_length,
                                [out, count = 3072] uint8_t* encrypted_dkg_secret,
                                [out] uint64_t * enc_len, size_t _t);

        public void trustedCreateBlsKeyV3(
                                [out]int *errStatus,
                                [out, count = SMALL_BUF_SIZE] char* err_string,
                                [in, string] const char* encrypted_secret_contributions,
                                [in, count = contribution_count] uint8_t* contributor_indices,
                                uint64_t contribution_count,
                                [in, count = SMALL_BUF_SIZE] uint8_t* encrypted_key,
                                uint64_t key_len,
                                [out, count = SMALL_BUF_SIZE] uint8_t * encr_bls_key,
                                [out] uint64_t *enc_bls_key_len);
    };

};
